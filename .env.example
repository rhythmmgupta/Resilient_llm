# Backend environment variables
# Comma-separated pool of at least 2 API keys (assigned key_1, key_2, ... in order)
LLM_API_KEYS=replace-with-key-1,replace-with-key-2

# Default LiteLLM model name (e.g., gemini/gemini-3.5-flash-lite, openai/gpt-4o-mini, groq/llama-3.3-70b-versatile)
LLM_MODEL=gemini/gemini-3.5-flash-lite

# Optional: comma-separated LiteLLM model names corresponding to each key in LLM_API_KEYS
# If omitted or shorter than LLM_API_KEYS, falls back to LLM_MODEL
# LLM_MODELS=gemini/gemini-3.5-flash-lite,gemini/gemini-3.5-flash

# Per-key request timeout in seconds before failing over to next key
LLM_TIMEOUT_SECONDS=30

# SQLite database URL (under Docker volume /data/app.db)
DATABASE_URL=sqlite:////data/app.db

# Comma-separated CORS origins allowed to call the backend
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enables X-Simulate-Failure header on POST /chat when set to true
ENABLE_FAILURE_SIMULATION=true

# LiteLLM built-in cache mode: "local" (in-memory) or "disk"
CACHE_TYPE=local
CACHE_DIR=/data/litellm_cache

# Default system prompt when client does not pass system_prompt
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise AI assistant.

# Frontend environment variables
VITE_API_BASE_URL=http://localhost:8000
